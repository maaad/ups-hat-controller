# Environment overrides for ups_hat_controller (systemd EnvironmentFile)
# Uncomment and adjust values as needed.

# I2C_BUS=1
# I2C_ADDR=45
# PUBLISH_RATE_HZ=1.0
# SHUTDOWN_DELAY_SEC=60
# SHUTDOWN_COMMAND=systemctl poweroff
# LOW_VOLTAGE_THRESHOLD=3150
# LOW_VOLTAGE_THRESHOLD_COUNT=30
# ENABLE_SYSLOG=true
# DRY_RUN=false
